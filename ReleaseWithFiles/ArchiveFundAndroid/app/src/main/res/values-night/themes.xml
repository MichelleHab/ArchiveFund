<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->

    <!-- Тёмная версия темы (автоматически подхватывается в ночном режиме) -->
    <style name="Theme.ArchiveFund" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Тёмные цвета для ночного режима -->
        <item name="colorPrimary">@color/purple_300</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_300</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:statusBarColor">@color/black</item>

        <!-- Цвет текста в меню для тёмной темы -->
        <item name="android:itemTextAppearance">@style/MenuTextStyleDark</item>
    </style>

    <style name="MenuTextStyleDark" parent="@android:style/TextAppearance.Widget.IconMenu.Item">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>